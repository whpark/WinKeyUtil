// Win32 resources : exe icon (Explorer) and version info
#include <winres.h>
#include "Version.h"

// first icon in the exe is used by Explorer
IDI_ICON1 ICON "res\\WinKeyUtil.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINKEYUTIL_VERSION_MAJOR,WINKEYUTIL_VERSION_MINOR,WINKEYUTIL_VERSION_PATCH,0
 PRODUCTVERSION WINKEYUTIL_VERSION_MAJOR,WINKEYUTIL_VERSION_MINOR,WINKEYUTIL_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Biscuit-lab"
			VALUE "FileDescription", "WinKeyUtil - keyboard utility"
			VALUE "FileVersion", WINKEYUTIL_VERSION_STR
			VALUE "InternalName", "WinKeyUtil"
			VALUE "LegalCopyright", "Copyright (C) 2026 Biscuit-lab whpark. MIT License."
			VALUE "OriginalFilename", "WinKeyUtil.exe"
			VALUE "ProductName", "WinKeyUtil"
			VALUE "ProductVersion", WINKEYUTIL_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
